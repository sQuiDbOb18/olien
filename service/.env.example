# PostgreSQL connection string; optional (default: postgres://olien:olien@localhost:5433/olien).
DATABASE_URL=postgres://user:password@localhost:5432/database

# Deployment JSON file to load; optional (default: ../deployments/10143.json).
DEPLOYMENTS_PATH=../deployments/10143.json

# Private key used to relay transactions; optional (read-only mode without it).
RELAYER_PK=replace-with-a-private-key

# JSON-RPC endpoint for chain reads and transactions; optional (default follows the deployment chain).
RPC_URL=https://rpc.example.invalid

# HTTP port for the service; optional (default: 8080).
PORT=8080

# Comma-separated browser origins allowed by CORS; optional (default: permissive).
CORS_ALLOWED_ORIGINS=https://console.example.invalid

# Optional member-directory URL for resolving @handles; optional (default: address-only names).
MEMBERS_URL=https://members.example.invalid

# Bearer token for the member directory; optional (used only with MEMBERS_URL).
MEMBERS_TOKEN=replace-with-a-members-token

# Maximum block range per log query; optional (default: 100 on Monad, chain-dependent elsewhere).
LOG_CHUNK_BLOCKS=100

# Block explorer base URL used in links; optional (default follows the deployment chain).
EXPLORER_URL=https://explorer.example.invalid

# EURC contract address on chains that support it; optional (default: chain-specific or none).
EURC_ADDRESS=0x0000000000000000000000000000000000000000

# Seconds between indexer runs; optional (default: 15).
INDEX_INTERVAL_SECS=15
